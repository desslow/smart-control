(function() {
    'use strict';

    // ================= ПЕРЕХВАТЧИКИ API И ТОКЕНОВ =================
    window._ozonAuthHeaders = null;
    let sessionsMap = new Map(); // sessionId -> foundAt
    let currentPostingsData = null;

    const origFetch = window.fetch;
    window.fetch = async function(...args) {
        try {
            const config = args[1];
            const url = typeof args[0] === 'string' ? args[0] : (args[0]?.url || '');

            // Сохраняем токены
            if (config && config.headers) {
                let headersObj = new Headers(config.headers);
                if (headersObj.has('authorization')) {
                    window._ozonAuthHeaders = {
                        'authorization': headersObj.get('authorization'),
                        'x-o3-app-name': headersObj.get('x-o3-app-name') || 'turbo-pvz-ui',
                        'x-o3-app-version': headersObj.get('x-o3-app-version') || '',
                        'x-o3-version-name': headersObj.get('x-o3-version-name') || ''
                    };
                }
            }

            const response = await origFetch.apply(this, args);

            // Перехватываем сессии для точного foundAt
            if (url.includes('/api2/giveout/Sessions')) {
                const clone = response.clone();
                clone.json().then(data => {
                    if (data && Array.isArray(data.sessions)) {
                        data.sessions.forEach(s => {
                            if (s.sessionId && s.foundAt) {
                                sessionsMap.set(String(s.sessionId), new Date(s.foundAt).getTime());
                            }
                        });
                    }
                }).catch(() => {});
            }

            // Перехватываем товары для расчета суммы "К оплате"
            if (url.includes('/api2/giveout/Postings')) {
                const clone = response.clone();
                clone.json().then(data => {
                    if (data && Array.isArray(data.postings)) {
                        currentPostingsData = data.postings;
                        updatePaymentDisplay();
                    }
                }).catch(() => {});
            }

            return response;
        } catch (e) {
            return origFetch.apply(this, args);
        }
    };

    // ================= СЛУЖЕБНЫЕ ПРОВЕРКИ =================
    function isSessionPage() {
        const path = window.location.pathname;
        const hasSessionUrl = /\/orders\/session(-new)?\/\d+/.test(path);
        const hasCardsInDom = !!document.querySelector('._card_1w2zp_1, [class*="_card_"]');
        return hasSessionUrl || (path.includes('/orders') && hasCardsInDom);
    }

    function getCurrentSessionId() {
        const match = window.location.pathname.match(/\/orders\/session(?:-new)?\/(\d+)/);
        return match ? match[1] : null;
    }

