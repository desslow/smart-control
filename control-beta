    // ================= ТАЙМЕР СЕССИИ (foundAt + FALLBACK) =================
    function updateSessionTimerUI() {
        const timerEl = document.getElementById('smart-session-timer');
        if (!timerEl) return;

        const sessionId = getCurrentSessionIdFromUrl();
        if (sessionId && sessionId !== currentSessionId) {
            currentSessionId = sessionId;

            // 1. Проверяем точный foundAt из перехвата API
            let foundAtTime = sessionsMap.get(String(sessionId));
            if (!foundAtTime) {
                const cached = localStorage.getItem(`ozon_found_at_${sessionId}`);
                if (cached) foundAtTime = parseInt(cached, 10);
            }

            // 2. Если пока нет в кэше — стартуем локальный fallback и сохраняем
            if (!foundAtTime) {
                foundAtTime = Date.now();
                localStorage.setItem(`ozon_found_at_${sessionId}`, String(foundAtTime));
            }

            currentFoundAtTimestamp = foundAtTime;
        }

        if (!currentFoundAtTimestamp) {
            timerEl.textContent = `⏱ 00:00`;
            return;
        }

        const elapsed = Math.max(0, Math.floor((Date.now() - currentFoundAtTimestamp) / 1000));
        const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
        const secs = String(elapsed % 60).padStart(2, '0');
        timerEl.textContent = `⏱ ${mins}:${secs}`;
    }

    function updatePaymentUI(amount) {
        if (typeof amount === 'number') calculatedPaymentAmount = amount;
        const payEl = document.getElementById('smart-session-pay');
        if (!payEl) return;

        if (calculatedPaymentAmount > 0) {
            payEl.className = 'smart-panel-pay pay-needed';
            payEl.innerHTML = `<span class="pay-dot"></span>К оплате: ${calculatedPaymentAmount} ₽`;
        } else {
            payEl.className = 'smart-panel-pay pay-clean';
            payEl.innerHTML = `✓ Оплачено`;
        }
    }

